# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.
# Used for local development only; the deployed Databricks App authenticates as its
# service principal and gets the warehouse from its "sql-warehouse" resource.

DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.x.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxx

# Auth: set ONE of the following
# Option A — run as the service principal (OAuth M2M)
DATABRICKS_CLIENT_ID=<sp-application-id>
DATABRICKS_CLIENT_SECRET=<sp-oauth-secret>
# Option B — run as yourself after `databricks auth login --host <workspace-url>`
# DATABRICKS_CONFIG_PROFILE=<profile>
